{
  "manifest_version": 3,
  "name": "Clicksheet",
  "version": "0.1.0",
  "description": "Capture browser journeys as visual context for coding agents.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Open Clicksheet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "pages/storage.html",
    "open_in_tab": true
  },
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture the current page into the open Journey"
    },
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Show or hide the Clicksheet widget"
    }
  }
}
