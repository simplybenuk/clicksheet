{
  "manifest_version": 3,
  "name": "Clicksheet",
  "version": "0.1.0",
  "description": "Capture browser journeys as visual context for coding agents.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Open Clicksheet"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "pages/storage.html",
    "open_in_tab": true
  }
}
